//@version=6
indicator("SMC LLM Candidate Detector", overlay=true, behind_chart=false, max_labels_count=500, max_boxes_count=300, max_lines_count=300)

// Phase 2 MVP notes:
// - This indicator emits provisional, deterministic setup facts only.
// - Final LLM approval/rejection is handled by the backend dashboard.
// - Alerts use alert() with dynamic JSON. Create a TradingView alert only after
//   reviewing the template with the user.
// - Order-block detection is intentionally stubbed as NONE in this phase because
//   Phase 2 scope focuses on BOS, FVG, sweeps, SMT, RVOL, consolidation, HTF bias,
//   session context, diagnostics, and structured alert payloads.

// -----------------------------------------------------------------------------+
// Inputs
// -----------------------------------------------------------------------------+
string companionOverride = input.string("", "Companion symbol override", tooltip="Leave blank to auto-pair ES with NQ and NQ with ES.")
int pivotLeft = input.int(3, "Pivot left bars", minval=1, maxval=20)
int pivotRight = input.int(3, "Pivot right bars", minval=1, maxval=20)
int minBreakTicks = input.int(2, "Minimum BOS break ticks", minval=1)
int minFvgTicks = input.int(2, "Minimum FVG ticks", minval=1)
int sweepBufferTicks = input.int(1, "Sweep buffer ticks", minval=0)
int equalHighLowToleranceTicks = input.int(4, "Equal high/low tolerance ticks", minval=1)
int smtLookback = input.int(20, "SMT lookback", minval=5, maxval=200)
int rvolLength = input.int(50, "RVOL length", minval=5, maxval=300)
float thinVolumeThreshold = input.float(0.70, "Thin RVOL threshold", minval=0.70, step=0.05)
float strongVolumeThreshold = input.float(1.50, "Strong RVOL threshold", minval=1.50, step=0.05)
int atrLength = input.int(14, "ATR length", minval=1, maxval=100)
float displacementAtrMult = input.float(1.0, "Displacement ATR multiple", minval=0.1, step=0.1)
int consolidationLookback = input.int(20, "Consolidation lookback", minval=5, maxval=200)
float consolidationAtrMult = input.float(2.0, "Consolidation range ATR multiple", minval=0.1, step=0.1)
float directionalEfficiencyMax = input.float(0.30, "Consolidation efficiency max", minval=0.01, maxval=1.0, step=0.01)
string htfTimeframe = input.timeframe("60", "HTF bias timeframe")
int htfFastEma = input.int(50, "HTF fast EMA", minval=1)
int htfSlowEma = input.int(200, "HTF slow EMA", minval=2)
int setupExpiryBars = input.int(30, "Setup expiry bars", minval=3, maxval=300)
float minRR = input.float(1.50, "Minimum candidate RR", minval=0.1, step=0.1)
float defaultRR = input.float(2.0, "Default TP RR multiple", minval=0.1, step=0.1)
int stopBufferTicks = input.int(2, "Stop buffer ticks", minval=0)
int minRuleScore = input.int(75, "Minimum rule score", minval=75, maxval=100)
int confirmationMaxBars = input.int(6, "Confirmation age limit", minval=3, maxval=6)
bool showDiagnostics = input.bool(true, "Show diagnostic table")
string panelMode = input.string("Compact", "Panel mode", options=["Compact", "Diagnostics"])
bool showZones = input.bool(false, "Show FVG zones")
bool showProofMarkers = input.bool(false, "Show proof markers")
bool showProvisionalTrades = input.bool(true, "Show candidate price labels")
bool enableAlerts = input.bool(true, "Enable alert() JSON payloads")
bool enableTestWebhookAlert = input.bool(false, "Enable test webhook alert", tooltip="Emits one schema-valid diagnostic payload on the next confirmed realtime bar. Disable after delivery testing.")

// -----------------------------------------------------------------------------+
// Utility helpers
// -----------------------------------------------------------------------------+
float tick = syminfo.mintick
// ticker.standard() strips chart modifiers such as settlement-as-close. Using
// raw syminfo.tickerid can inject TradingView's internal modifier descriptor
// into JSON string fields and make an otherwise valid payload malformed.
string alertSymbol = ticker.standard(syminfo.tickerid)

f_num(float value) =>
    // JSON numbers require a leading zero for values between -1 and 1.
    na(value) ? "null" : str.tostring(value, "0.########")

f_int(int value) =>
    na(value) ? "null" : str.tostring(value)

f_bool(bool value) =>
    value ? "true" : "false"

f_event_status(string state, int age, bool eligible) =>
    state == "NONE" or na(age) ? "NONE" : state + " " + str.tostring(age) + "b " + (eligible ? "READY" : age > confirmationMaxBars ? "EXPIRED" : "ORDER BLOCK")

f_state_color(string value) =>
    str.contains(value, "EXPIRED") or str.contains(value, "ORDER BLOCK") ? color.orange :
     str.contains(value, "READY") ? color.lime :
     value == "BULLISH" ? color.new(color.lime, 0) :
     value == "BEARISH" ? color.new(color.red, 0) :
     value == "PASS" ? color.new(color.lime, 0) :
     value == "BLOCK" ? color.new(color.red, 0) :
     value == "STRONG" ? color.new(color.lime, 0) :
     value == "THIN" ? color.new(color.orange, 0) :
     value == "BLOCKING" ? color.new(color.red, 0) :
     value == "MITIGATED" ? color.new(color.gray, 0) :
     color.new(color.silver, 0)

f_root_symbol() =>
    str.contains(alertSymbol, "NQ") ? "NQ" :
     str.contains(alertSymbol, "ES") ? "ES" :
     "UNKNOWN"

string rootSymbol = f_root_symbol()
string autoCompanion = rootSymbol == "ES" ? "CME_MINI:NQ1!" : rootSymbol == "NQ" ? "CME_MINI:ES1!" : "CME_MINI:NQ1!"
string companionSymbol = companionOverride == "" ? autoCompanion : companionOverride

// Object retention keeps TradingView drawing limits under control on long charts.
int maxStoredObjects = 30
var array<box> fvgBoxes = array.new<box>()
var array<label> proofLabels = array.new<label>()

f_store_box(box item) =>
    array.push(fvgBoxes, item)
    if array.size(fvgBoxes) > maxStoredObjects
        box old = array.shift(fvgBoxes)
        box.delete(old)

f_store_label(label item) =>
    array.push(proofLabels, item)
    if array.size(proofLabels) > maxStoredObjects
        label old = array.shift(proofLabels)
        label.delete(old)

f_retire_box(box item, string reason) =>
    if not na(item)
        box.set_right(item, bar_index)
        box.set_bgcolor(item, color.new(color.gray, 94))
        box.set_border_color(item, color.new(color.gray, 75))
        box.set_text(item, reason)
        box.set_text_color(item, color.silver)
        box.set_text_size(item, size.tiny)

// -----------------------------------------------------------------------------+
// Exact session windows from CLOSED one-minute bars, in New York time.
// Chart bars may straddle boundaries; their full high/low must never be used.
// Timestamp construction (rather than fixed UTC offsets) handles DST.
// -----------------------------------------------------------------------------+
f_session_window(int at) =>
    string tz = "America/New_York"
    int minuteOfDay = hour(at, tz) * 60 + minute(at, tz)
    string name = minuteOfDay >= 1080 ? "ASIA" : minuteOfDay >= 120 and minuteOfDay < 300 ? "LONDON" : minuteOfDay >= 510 and minuteOfDay < 690 ? "NY_AM" : minuteOfDay >= 810 and minuteOfDay < 960 ? "NY_PM" : "OFF_HOURS"
    int startMinute = name == "ASIA" ? 1080 : name == "LONDON" ? 120 : name == "NY_AM" ? 510 : name == "NY_PM" ? 810 : 0
    int endMinute = name == "ASIA" ? 1440 : name == "LONDON" ? 300 : name == "NY_AM" ? 690 : name == "NY_PM" ? 960 : 0
    int starts = timestamp(tz, year(at, tz), month(at, tz), dayofmonth(at, tz), int(startMinute / 60), startMinute % 60)
    int ends = timestamp(tz, year(at, tz), month(at, tz), dayofmonth(at, tz), int(endMinute / 60), endMinute % 60)
    [name, starts, ends]

// Kept as one stateful helper so the actual Pine code can be exercised with
// synthetic minute arrays in the regression probe, without live alerts.
f_session_context(array<int> minuteTimes, array<int> minuteCloses, array<float> minuteHighs, array<float> minuteLows, int chartOpen, int chartClose, int cutoff, bool realtime, bool confirmed) =>
    var int trackedSessionStart = na
    var int trackedSessionEnd = na
    var int trackedMinuteClose = na
    var float trackedSessionHigh = na
    var float trackedSessionLow = na
    var bool trackedSessionComplete = false
    var float completedSessionHigh = na
    var float completedSessionLow = na
    var int completedSessionEnd = na
    // Freeze the sweep pool BEFORE ingesting this chart bar. A session finishing
    // inside a 4h candle cannot be swept retroactively by that same candle's wick.
    float sweepSessionHigh = completedSessionHigh
    float sweepSessionLow = completedSessionLow
    int sweepSessionEnd = completedSessionEnd
    string sessionName = "OFF_HOURS"
    float currentSessionHigh = na
    float currentSessionLow = na
    int sessionAsOf = na
    bool minuteCoverageComplete = true
    int expectedMinute = chartOpen
    int minuteCount = array.size(minuteTimes)
    if minuteCount > 0
        for i = 0 to minuteCount - 1
            int at = array.get(minuteTimes, i)
            int endsAt = array.get(minuteCloses, i)
            // Never incorporate an unfinished minute on a realtime chart bar.
            if endsAt <= chartClose and (not realtime or endsAt <= cutoff)
                minuteCoverageComplete := minuteCoverageComplete and at == expectedMinute and endsAt - at == 60000
                expectedMinute := endsAt
                sessionAsOf := endsAt
                [name, starts, ends] = f_session_window(at)
                sessionName := name
                if name != "OFF_HOURS"
                    if na(trackedSessionStart) or starts != trackedSessionStart
                        trackedSessionStart := starts
                        trackedSessionEnd := ends
                        trackedSessionHigh := array.get(minuteHighs, i)
                        trackedSessionLow := array.get(minuteLows, i)
                        trackedSessionComplete := at == starts
                    else
                        trackedSessionComplete := trackedSessionComplete and at == trackedMinuteClose
                        trackedSessionHigh := math.max(trackedSessionHigh, array.get(minuteHighs, i))
                        trackedSessionLow := math.min(trackedSessionLow, array.get(minuteLows, i))
                    trackedMinuteClose := endsAt
                    currentSessionHigh := trackedSessionComplete ? trackedSessionHigh : na
                    currentSessionLow := trackedSessionComplete ? trackedSessionLow : na
                    if endsAt == trackedSessionEnd
                        // A partial/missing session invalidates the prior pool too.
                        completedSessionHigh := trackedSessionComplete ? trackedSessionHigh : na
                        completedSessionLow := trackedSessionComplete ? trackedSessionLow : na
                        completedSessionEnd := trackedSessionComplete ? endsAt : na
                else
                    currentSessionHigh := na
                    currentSessionLow := na
    // Fail closed outside TradingView's intrabar history or with missing minutes.
    // In live diagnostics, partial current bars are explicitly PREVIEW, not confirmed.
    bool sessionDataReady = not na(sessionAsOf) and minuteCoverageComplete and (not confirmed or sessionAsOf == chartClose)
    [sessionName, currentSessionHigh, currentSessionLow, completedSessionHigh, completedSessionLow, sweepSessionHigh, sweepSessionLow, sweepSessionEnd, sessionAsOf, sessionDataReady]

[minuteTimes, minuteCloses, minuteHighs, minuteLows] = request.security_lower_tf(syminfo.tickerid, "1", [time, time_close, high, low], ignore_invalid_timeframe=true)
[sessionName, currentSessionHigh, currentSessionLow, completedSessionHigh, completedSessionLow, sweepSessionHigh, sweepSessionLow, sweepSessionEnd, sessionAsOf, sessionDataReady] = f_session_context(minuteTimes, minuteCloses, minuteHighs, minuteLows, time, time_close, timenow, barstate.isrealtime, barstate.isconfirmed)

// Offset + lookahead_on maps the PREVIOUS completed day from the start of each
// new daily interval, identically on historical and realtime intraday bars.
float priorDayHigh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
float priorDayLow = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)

// -----------------------------------------------------------------------------+
// Swing structure and Break of Structure.
// -----------------------------------------------------------------------------+
float pivotHigh = ta.pivothigh(high, pivotLeft, pivotRight)
float pivotLow = ta.pivotlow(low, pivotLeft, pivotRight)

var float previousSwingHigh = na
var float lastSwingHigh = na
var int lastSwingHighBar = na
var float previousSwingLow = na
var float lastSwingLow = na
var int lastSwingLowBar = na

if not na(pivotHigh)
    previousSwingHigh := lastSwingHigh
    lastSwingHigh := pivotHigh
    lastSwingHighBar := bar_index - pivotRight

if not na(pivotLow)
    previousSwingLow := lastSwingLow
    lastSwingLow := pivotLow
    lastSwingLowBar := bar_index - pivotRight

float breakBuffer = minBreakTicks * tick
bool bullishBos = barstate.isconfirmed and not na(lastSwingHigh) and close > lastSwingHigh + breakBuffer and close[1] <= lastSwingHigh + breakBuffer
bool bearishBos = barstate.isconfirmed and not na(lastSwingLow) and close < lastSwingLow - breakBuffer and close[1] >= lastSwingLow - breakBuffer

var string bosState = "NONE"
var float bosLevel = na
var int bosBar = na

if bullishBos
    bosState := "BULLISH"
    bosLevel := lastSwingHigh
    bosBar := bar_index
    if showProofMarkers
        f_store_label(label.new(bar_index, high, "BOS BULL", textcolor=color.white, color=color.green))

if bearishBos
    bosState := "BEARISH"
    bosLevel := lastSwingLow
    bosBar := bar_index
    if showProofMarkers
        f_store_label(label.new(bar_index, low, "BOS BEAR", textcolor=color.white, color=color.red))

int bosAge = na(bosBar) ? 100000 : bar_index - bosBar
bool bullBosRecent = bosState == "BULLISH" and bosAge <= confirmationMaxBars
bool bearBosRecent = bosState == "BEARISH" and bosAge <= confirmationMaxBars

// -----------------------------------------------------------------------------+
// Fair Value Gap. A single active FVG is tracked for deterministic payloads.
// -----------------------------------------------------------------------------+
float fvgMinSize = minFvgTicks * tick
bool newBullFvg = barstate.isconfirmed and low > high[2] and (low - high[2]) >= fvgMinSize
bool newBearFvg = barstate.isconfirmed and high < low[2] and (low[2] - high) >= fvgMinSize

var string fvgState = "NONE"
var float fvgLow = na
var float fvgHigh = na
var int fvgBar = na
var box activeFvgBox = na
var int alertedFvgBar = na

if newBullFvg
    f_retire_box(activeFvgBox, "SUPERSEDED")
    activeFvgBox := na
    fvgState := "BULLISH"
    fvgLow := high[2]
    fvgHigh := low
    fvgBar := bar_index
    if showZones
        activeFvgBox := box.new(bar_index - 2, fvgHigh, bar_index + setupExpiryBars, fvgLow, xloc=xloc.bar_index, bgcolor=color.new(color.lime, 84), border_color=color.new(color.lime, 35))
        f_store_box(activeFvgBox)

if newBearFvg
    f_retire_box(activeFvgBox, "SUPERSEDED")
    activeFvgBox := na
    fvgState := "BEARISH"
    fvgLow := high
    fvgHigh := low[2]
    fvgBar := bar_index
    if showZones
        activeFvgBox := box.new(bar_index - 2, fvgHigh, bar_index + setupExpiryBars, fvgLow, xloc=xloc.bar_index, bgcolor=color.new(color.red, 84), border_color=color.new(color.red, 35))
        f_store_box(activeFvgBox)

int fvgAge = na(fvgBar) ? na : bar_index - fvgBar
bool fvgExpired = not na(fvgAge) and fvgAge > setupExpiryBars
// A close through the far boundary invalidates the zone before eligibility.
bool zoneInvalidated = (fvgState == "BULLISH" and close < fvgLow) or (fvgState == "BEARISH" and close > fvgHigh)
bool activeBullFvg = fvgState == "BULLISH" and not fvgExpired and not zoneInvalidated and not na(fvgLow) and not na(fvgHigh)
bool activeBearFvg = fvgState == "BEARISH" and not fvgExpired and not zoneInvalidated and not na(fvgLow) and not na(fvgHigh)
bool fvgTouched = (activeBullFvg or activeBearFvg) and bar_index > fvgBar and high >= fvgLow and low <= fvgHigh

if not na(activeFvgBox) and (activeBullFvg or activeBearFvg)
    box.set_right(activeFvgBox, bar_index + setupExpiryBars)

// -----------------------------------------------------------------------------+
// Liquidity sweeps from prior day, completed session, and equal pivot pools.
// -----------------------------------------------------------------------------+
float equalTolerance = equalHighLowToleranceTicks * tick
bool hasEqualHigh = not na(lastSwingHigh) and not na(previousSwingHigh) and math.abs(lastSwingHigh - previousSwingHigh) <= equalTolerance
bool hasEqualLow = not na(lastSwingLow) and not na(previousSwingLow) and math.abs(lastSwingLow - previousSwingLow) <= equalTolerance
float equalHighLevel = hasEqualHigh ? (lastSwingHigh + previousSwingHigh) / 2.0 : na
float equalLowLevel = hasEqualLow ? (lastSwingLow + previousSwingLow) / 2.0 : na

float watchedHigh = na
string watchedHighPool = "NONE"
if not na(priorDayHigh)
    watchedHigh := priorDayHigh
    watchedHighPool := "PRIOR_DAY_HIGH"
if not na(sweepSessionHigh) and sweepSessionEnd <= time
    watchedHigh := sweepSessionHigh
    watchedHighPool := "SESSION_HIGH"
if not na(equalHighLevel)
    watchedHigh := equalHighLevel
    watchedHighPool := "EQUAL_HIGH"

float watchedLow = na
string watchedLowPool = "NONE"
if not na(priorDayLow)
    watchedLow := priorDayLow
    watchedLowPool := "PRIOR_DAY_LOW"
if not na(sweepSessionLow) and sweepSessionEnd <= time
    watchedLow := sweepSessionLow
    watchedLowPool := "SESSION_LOW"
if not na(equalLowLevel)
    watchedLow := equalLowLevel
    watchedLowPool := "EQUAL_LOW"

float sweepBuffer = sweepBufferTicks * tick
bool bearishSweep = barstate.isconfirmed and not na(watchedHigh) and high > watchedHigh + sweepBuffer and close < watchedHigh
bool bullishSweep = barstate.isconfirmed and not na(watchedLow) and low < watchedLow - sweepBuffer and close > watchedLow

var string sweepState = "NONE"
var float sweepLevel = na
var string sweepPoolType = "NONE"
var int sweepBar = na
var float lastBullSweepLevel = na
var float lastBearSweepLevel = na

if bullishSweep
    sweepState := "BULLISH"
    sweepLevel := watchedLow
    sweepPoolType := watchedLowPool
    sweepBar := bar_index
    lastBullSweepLevel := low
    if showProofMarkers
        label sweepLabel = label.new(bar_index, low, "SWEEP BULL", style=label.style_label_up, textcolor=color.white, color=color.new(color.lime, 0))
        f_store_label(sweepLabel)

if bearishSweep
    sweepState := "BEARISH"
    sweepLevel := watchedHigh
    sweepPoolType := watchedHighPool
    sweepBar := bar_index
    lastBearSweepLevel := high
    if showProofMarkers
        label sweepLabel = label.new(bar_index, high, "SWEEP BEAR", style=label.style_label_down, textcolor=color.white, color=color.new(color.red, 0))
        f_store_label(sweepLabel)

int sweepAge = na(sweepBar) ? na : bar_index - sweepBar
bool bullSweepRecent = sweepState == "BULLISH" and not na(sweepAge) and bosAge <= sweepAge and sweepAge <= confirmationMaxBars
bool bearSweepRecent = sweepState == "BEARISH" and not na(sweepAge) and bosAge <= sweepAge and sweepAge <= confirmationMaxBars

// -----------------------------------------------------------------------------+
// SMT divergence. This is a rolling-window approximation, not pivot-aligned SMT.
// -----------------------------------------------------------------------------+
[compHigh, compLow, compTime, compCloseTime] = request.security(companionSymbol, timeframe.period, [high, low, time, time_close], gaps=barmerge.gaps_on, ignore_invalid_symbol=true)
bool companionAligned = not na(compHigh) and not na(compLow) and compTime == time and compCloseTime == time_close
bool currentMakesHigh = high >= ta.highest(high, smtLookback)
bool currentMakesLow = low <= ta.lowest(low, smtLookback)
bool companionMakesHigh = compHigh >= ta.highest(compHigh, smtLookback)
bool companionMakesLow = compLow <= ta.lowest(compLow, smtLookback)
bool bearishSmt = barstate.isconfirmed and companionAligned and currentMakesHigh and not companionMakesHigh
bool bullishSmt = barstate.isconfirmed and companionAligned and currentMakesLow and not companionMakesLow

var string smtState = "NONE"
var int smtBar = na

if bullishSmt
    smtState := "BULLISH"
    smtBar := bar_index
    if showProofMarkers
        label smtLabel = label.new(bar_index, low, "SMT BULL", style=label.style_label_up, textcolor=color.white, color=color.new(color.teal, 0))
        f_store_label(smtLabel)

if bearishSmt
    smtState := "BEARISH"
    smtBar := bar_index
    if showProofMarkers
        label smtLabel = label.new(bar_index, high, "SMT BEAR", style=label.style_label_down, textcolor=color.white, color=color.new(color.maroon, 0))
        f_store_label(smtLabel)

int smtAge = na(smtBar) ? na : bar_index - smtBar
bool bullSmtRecent = smtState == "BULLISH" and not na(smtAge) and bosAge <= smtAge and smtAge <= confirmationMaxBars
bool bearSmtRecent = smtState == "BEARISH" and not na(smtAge) and bosAge <= smtAge and smtAge <= confirmationMaxBars

// -----------------------------------------------------------------------------+
// Relative volume, displacement, consolidation, and HTF bias.
// -----------------------------------------------------------------------------+
float atr = ta.atr(atrLength)
float volumeSma = ta.sma(volume, rvolLength)
float rvol = volumeSma > 0 ? volume / volumeSma : 0.0
string volumeState = rvol < thinVolumeThreshold ? "THIN" : rvol >= strongVolumeThreshold ? "STRONG" : "NEUTRAL"
bool volumeAllowed = volumeState != "THIN" and rvol >= 0.70

float candleRange = math.max(high - low, tick)
float candleBody = math.abs(close - open)
bool bullDisplacement = candleBody >= displacementAtrMult * atr and close > open and close >= low + 0.75 * candleRange
bool bearDisplacement = candleBody >= displacementAtrMult * atr and close < open and close <= low + 0.25 * candleRange
string displacementState = bullDisplacement ? "BULLISH" : bearDisplacement ? "BEARISH" : candleBody > 0 ? "WEAK" : "NONE"

float compressionRange = ta.highest(high, consolidationLookback) - ta.lowest(low, consolidationLookback)
float rangeAtrMultiple = atr > 0 ? compressionRange / atr : 0.0
float path = math.sum(math.abs(close - close[1]), consolidationLookback)
float directionalEfficiency = path > 0 ? math.abs(close - close[consolidationLookback]) / path : 0.0
bool rangeCompressed = rangeAtrMultiple <= consolidationAtrMult
bool lowEfficiency = directionalEfficiency < directionalEfficiencyMax
bool rawConsolidation = rangeCompressed and lowEfficiency
// Two completed clear bars prevent an intrabar/one-bar release of the pause.
var int consolidationClearBars = 0
if barstate.isconfirmed
    consolidationClearBars := rawConsolidation or na(path) or na(atr) ? 0 : math.min(2, consolidationClearBars + 1)
bool consolidationActive = rawConsolidation or consolidationClearBars < 2

bgcolor(consolidationActive ? color.new(color.gray, 88) : na, title="Consolidation shading")

// The PRD default is 60m. Escalate it on 1h/4h charts so this is always a
// higher-timeframe filter; a user-selected timeframe above the chart wins.
int chartSeconds = timeframe.in_seconds(timeframe.period)
string autoHtfTimeframe = chartSeconds >= timeframe.in_seconds("D") ? timeframe.from_seconds(chartSeconds * 4) : chartSeconds >= timeframe.in_seconds("240") ? "D" : chartSeconds >= timeframe.in_seconds("60") ? "240" : "60"
string effectiveHtfTimeframe = timeframe.in_seconds(htfTimeframe) > chartSeconds ? htfTimeframe : autoHtfTimeframe
// Use the last completed HTF candle so historical chart markers and realtime
// alert decisions see the same bias instead of an in-progress HTF candle.
float htfClose = request.security(syminfo.tickerid, effectiveHtfTimeframe, close[1], lookahead=barmerge.lookahead_on)
float htfFast = request.security(syminfo.tickerid, effectiveHtfTimeframe, ta.ema(close, htfFastEma)[1], lookahead=barmerge.lookahead_on)
float htfSlow = request.security(syminfo.tickerid, effectiveHtfTimeframe, ta.ema(close, htfSlowEma)[1], lookahead=barmerge.lookahead_on)
string htfBias = htfClose > htfFast and htfFast > htfSlow ? "BULLISH" : htfClose < htfFast and htfFast < htfSlow ? "BEARISH" : "NEUTRAL"

// -----------------------------------------------------------------------------+
// Candidate scoring and provisional risk.
// -----------------------------------------------------------------------------+
float entryLow = fvgLow
float entryHigh = fvgHigh
float entryPreferred = math.round_to_mintick((entryLow + entryHigh) / 2.0)

float bullStop = math.min(bullSweepRecent ? lastBullSweepLevel : entryLow, entryLow) - stopBufferTicks * tick
float bearStop = math.max(bearSweepRecent ? lastBearSweepLevel : entryHigh, entryHigh) + stopBufferTicks * tick
float bullRisk = entryPreferred - bullStop
float bearRisk = bearStop - entryPreferred
float bullTarget = math.round_to_mintick(entryPreferred + defaultRR * bullRisk)
float bearTarget = math.round_to_mintick(entryPreferred - defaultRR * bearRisk)
float bullReward = bullTarget - entryPreferred
float bearReward = entryPreferred - bearTarget
float bullRR = bullRisk > 0 ? bullReward / bullRisk : na
float bearRR = bearRisk > 0 ? bearReward / bearRisk : na

int bullScoreRaw = 0
bullScoreRaw += activeBullFvg ? 25 : 0
bullScoreRaw += bullSweepRecent ? 10 : 0
bullScoreRaw += bullBosRecent ? 20 : 0
bullScoreRaw += bullSmtRecent ? 10 : 0
bullScoreRaw += volumeState == "STRONG" ? 10 : 0
bullScoreRaw += htfBias == "BULLISH" ? 15 : 0
bullScoreRaw += displacementState == "BULLISH" ? 10 : 0
int bullScore = int(math.min(100, math.max(0, bullScoreRaw)))

int bearScoreRaw = 0
bearScoreRaw += activeBearFvg ? 25 : 0
bearScoreRaw += bearSweepRecent ? 10 : 0
bearScoreRaw += bearBosRecent ? 20 : 0
bearScoreRaw += bearSmtRecent ? 10 : 0
bearScoreRaw += volumeState == "STRONG" ? 10 : 0
bearScoreRaw += htfBias == "BEARISH" ? 15 : 0
bearScoreRaw += displacementState == "BEARISH" ? 10 : 0
int bearScore = int(math.min(100, math.max(0, bearScoreRaw)))

// strict_v1: liquidity precedes BOS; FVG forms on BOS or within two bars;
// retest follows formation. Backend independently checks these declared ages.
bool sequenceValid = not na(fvgAge) and 1 <= fvgAge and fvgAge <= bosAge and bosAge <= math.min(fvgAge + 2, confirmationMaxBars)
bool supportedChart = rootSymbol != "UNKNOWN" and (timeframe.period == "5" or timeframe.period == "15" or timeframe.period == "60" or timeframe.period == "240")
bool commonGate = barstate.isconfirmed and supportedChart and sessionDataReady and companionAligned and sequenceValid and fvgTouched and not consolidationActive and volumeAllowed
bool bullCandidate = commonGate and activeBullFvg and (bullSweepRecent or bullSmtRecent) and bullBosRecent and htfBias == "BULLISH" and close > bullStop and close < bullTarget and not na(bullRR) and bullRR >= math.max(1.5, minRR) and bullScore >= minRuleScore
bool bearCandidate = commonGate and activeBearFvg and (bearSweepRecent or bearSmtRecent) and bearBosRecent and htfBias == "BEARISH" and close < bearStop and close > bearTarget and not na(bearRR) and bearRR >= math.max(1.5, minRR) and bearScore >= minRuleScore

bool chooseBull = bullCandidate and (not bearCandidate or bullScore >= bearScore)
bool chooseBear = bearCandidate and not chooseBull
string candidateDirection = chooseBull ? "BULLISH" : chooseBear ? "BEARISH" : "NONE"
int selectedScore = chooseBull ? bullScore : chooseBear ? bearScore : 0
float selectedStop = chooseBull ? bullStop : chooseBear ? bearStop : na
float selectedTarget = chooseBull ? bullTarget : chooseBear ? bearTarget : na
float selectedRisk = chooseBull ? bullRisk : chooseBear ? bearRisk : na
float selectedReward = chooseBull ? bullReward : chooseBear ? bearReward : na
float selectedRR = chooseBull ? bullRR : chooseBear ? bearRR : na
bool selectedCandidate = chooseBull or chooseBear
bool alreadyAlertedThisFvg = not na(alertedFvgBar) and not na(fvgBar) and alertedFvgBar == fvgBar
bool newCandidate = selectedCandidate and not alreadyAlertedThisFvg
bool shouldAlert = enableAlerts and not enableTestWebhookAlert and newCandidate

// A rolling window makes the chart's recent setup frequency visible without
// changing candidate eligibility or emitting diagnostic alerts.
int recentFvgRetests = int(math.sum(barstate.isconfirmed and fvgTouched ? 1 : 0, 100))
int recentCandidates = int(math.sum(selectedCandidate and not alreadyAlertedThisFvg ? 1 : 0, 100))

// Test delivery is intentionally stricter than alert.freq_once_per_bar_close:
// the latch permits one alert for the entire enabled runtime, not one per bar.
// Toggling the input off and on starts a new runtime and rearms the latch.
var bool testWebhookAlertSent = false
bool shouldSendTestWebhook = enableAlerts and enableTestWebhookAlert and barstate.isrealtime and barstate.isconfirmed and not testWebhookAlertSent

if newCandidate and showProvisionalTrades
    string prices = "\nEntry " + f_num(entryPreferred) + " | SL " + f_num(selectedStop) + "\nTP " + f_num(selectedTarget) + " | RR " + f_num(selectedRR)
    label candidateLabel = label.new(bar_index, chooseBull ? low : high, (chooseBull ? "BUY CANDIDATE" : "SELL CANDIDATE") + prices, style=chooseBull ? label.style_label_up : label.style_label_down, textcolor=color.white, color=chooseBull ? color.new(color.green, 0) : color.new(color.red, 0), size=size.small)
    f_store_label(candidateLabel)

// Build and send strict setup_alert.schema.json payloads. Nullable feature fields
// are emitted as JSON null, while active trade/risk fields are numeric.
if shouldAlert
    string setupId = alertSymbol + "_" + timeframe.period + "_" + str.tostring(time) + "_strict_v1"
    string barTimeIso = str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    string payload = "{"
    payload += "\"schema_version\":\"1.0\","
    payload += "\"setup_id\":\"" + setupId + "\","
    payload += "\"source\":\"tradingview_pine\","
    payload += "\"symbol\":\"" + alertSymbol + "\","
    payload += "\"root_symbol\":\"" + rootSymbol + "\","
    payload += "\"companion_symbol\":\"" + companionSymbol + "\","
    payload += "\"timeframe\":\"" + timeframe.period + "\","
    payload += "\"bar_time\":\"" + barTimeIso + "\","
    payload += "\"bar_index\":" + str.tostring(bar_index) + ","
    payload += "\"direction\":\"" + candidateDirection + "\","
    payload += "\"rule_score\":" + str.tostring(selectedScore) + ","
    payload += "\"price\":" + f_num(close) + ","
    payload += "\"entry\":{\"zone_type\":\"FVG\",\"low\":" + f_num(entryLow) + ",\"high\":" + f_num(entryHigh) + ",\"preferred\":" + f_num(entryPreferred) + "},"
    payload += "\"risk\":{\"stop_loss\":" + f_num(selectedStop) + ",\"take_profit_1\":" + f_num(selectedTarget) + ",\"risk_reward\":" + f_num(selectedRR) + ",\"risk_points\":" + f_num(selectedRisk) + ",\"reward_points\":" + f_num(selectedReward) + "},"
    payload += "\"features\":{"
    payload += "\"bos\":{\"state\":\"" + (chooseBull and bullBosRecent ? "BULLISH" : chooseBear and bearBosRecent ? "BEARISH" : "NONE") + "\",\"level\":" + f_num((chooseBull and bullBosRecent) or (chooseBear and bearBosRecent) ? bosLevel : na) + "},"
    payload += "\"fvg\":{\"state\":\"" + (chooseBull ? "BULLISH" : "BEARISH") + "\",\"low\":" + f_num(fvgLow) + ",\"high\":" + f_num(fvgHigh) + ",\"age_bars\":" + f_int(fvgAge) + "},"
    payload += "\"order_block\":{\"state\":\"NONE\",\"low\":null,\"high\":null,\"age_bars\":null},"
    payload += "\"liquidity_sweep\":{\"state\":\"" + (chooseBull and bullSweepRecent ? "BULLISH" : chooseBear and bearSweepRecent ? "BEARISH" : "NONE") + "\",\"level\":" + f_num((chooseBull and bullSweepRecent) or (chooseBear and bearSweepRecent) ? sweepLevel : na) + ",\"pool_type\":\"" + (((chooseBull and bullSweepRecent) or (chooseBear and bearSweepRecent)) ? sweepPoolType : "NONE") + "\",\"age_bars\":" + f_int(((chooseBull and bullSweepRecent) or (chooseBear and bearSweepRecent)) ? sweepAge : na) + "},"
    payload += "\"smt\":{\"state\":\"" + (chooseBull and bullSmtRecent ? "BULLISH" : chooseBear and bearSmtRecent ? "BEARISH" : "NONE") + "\",\"lookback\":" + str.tostring(smtLookback) + "},"
    payload += "\"volume\":{\"rvol\":" + f_num(rvol) + ",\"state\":\"" + volumeState + "\"},"
    payload += "\"consolidation\":{\"active\":" + f_bool(consolidationActive) + ",\"directional_efficiency\":" + f_num(directionalEfficiency) + ",\"range_atr_multiple\":" + f_num(rangeAtrMultiple) + "},"
    payload += "\"htf_bias\":\"" + htfBias + "\","
    payload += "\"displacement\":\"" + displacementState + "\""
    payload += "},"
    payload += "\"session\":{\"name\":\"" + sessionName + "\",\"current_high\":" + f_num(currentSessionHigh) + ",\"current_low\":" + f_num(currentSessionLow) + ",\"completed_high\":" + f_num(completedSessionHigh) + ",\"completed_low\":" + f_num(completedSessionLow) + "},"
    payload += "\"diagnostics\":{\"policy_version\":\"strict_v1\",\"detector_revision\":\"timing_sessions_v2\",\"session_data_ready\":" + f_bool(sessionDataReady) + ",\"session_resolution\":\"1\",\"session_as_of_ms\":" + f_int(sessionAsOf) + ",\"sweep_session_end_ms\":" + f_int(sweepSessionEnd) + ",\"bar_close_time\":\"" + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\",\"test_mode\":false,\"fvg_retested\":true,\"zone_invalidated\":false,\"companion_aligned\":" + f_bool(companionAligned) + ",\"consolidation_clear_bars\":" + f_int(consolidationClearBars) + ",\"atr\":" + f_num(atr) + ",\"mintick\":" + f_num(tick) + ",\"bos_age_bars\":" + f_int(bosAge) + ",\"sweep_age_bars\":" + f_int(sweepAge) + ",\"smt_age_bars\":" + f_int(smtAge) + ",\"notes\":\"Strict candidate; entry is pending, not filled\"}"
    payload += "}"
    alert(payload, alert.freq_once_per_bar_close)

// Deduplicate chart candidates even when JSON alerts are disabled.
if newCandidate
    alertedFvgBar := fvgBar

// Emit a deterministic, schema-valid bullish setup solely to prove the
// TradingView -> public tunnel -> backend delivery path. This bypasses SMC
// candidate conditions but never bypasses backend schema or decision validation.
if shouldSendTestWebhook
    float testEntryLow = close - 2.0 * tick
    float testEntryHigh = close + 2.0 * tick
    float testEntryPreferred = close
    float testRiskPoints = 8.0 * tick
    float testRewardPoints = 16.0 * tick
    float testStop = testEntryPreferred - testRiskPoints
    float testTarget = testEntryPreferred + testRewardPoints
    string testSetupId = alertSymbol + "_" + timeframe.period + "_TEST_" + str.tostring(time) + "_" + str.tostring(bar_index)
    string testBarTimeIso = str.format_time(time, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC")
    string testPayload = "{"
    testPayload += "\"schema_version\":\"1.0\","
    testPayload += "\"setup_id\":\"" + testSetupId + "\","
    testPayload += "\"source\":\"tradingview_pine\","
    testPayload += "\"symbol\":\"" + alertSymbol + "\","
    testPayload += "\"root_symbol\":\"" + rootSymbol + "\","
    testPayload += "\"companion_symbol\":\"" + companionSymbol + "\","
    testPayload += "\"timeframe\":\"" + timeframe.period + "\","
    testPayload += "\"bar_time\":\"" + testBarTimeIso + "\","
    testPayload += "\"bar_index\":" + str.tostring(bar_index) + ","
    testPayload += "\"direction\":\"BULLISH\","
    testPayload += "\"rule_score\":100,"
    testPayload += "\"price\":" + f_num(close) + ","
    testPayload += "\"entry\":{\"zone_type\":\"FVG\",\"low\":" + f_num(testEntryLow) + ",\"high\":" + f_num(testEntryHigh) + ",\"preferred\":" + f_num(testEntryPreferred) + "},"
    testPayload += "\"risk\":{\"stop_loss\":" + f_num(testStop) + ",\"take_profit_1\":" + f_num(testTarget) + ",\"risk_reward\":2.0,\"risk_points\":" + f_num(testRiskPoints) + ",\"reward_points\":" + f_num(testRewardPoints) + "},"
    testPayload += "\"features\":{"
    testPayload += "\"bos\":{\"state\":\"NONE\",\"level\":null},"
    testPayload += "\"fvg\":{\"state\":\"BULLISH\",\"low\":" + f_num(testEntryLow) + ",\"high\":" + f_num(testEntryHigh) + ",\"age_bars\":0},"
    testPayload += "\"order_block\":{\"state\":\"NONE\",\"low\":null,\"high\":null,\"age_bars\":null},"
    testPayload += "\"liquidity_sweep\":{\"state\":\"NONE\",\"level\":null,\"pool_type\":\"NONE\",\"age_bars\":null},"
    testPayload += "\"smt\":{\"state\":\"NONE\",\"lookback\":" + str.tostring(smtLookback) + "},"
    testPayload += "\"volume\":{\"rvol\":1.0,\"state\":\"NEUTRAL\"},"
    testPayload += "\"consolidation\":{\"active\":false,\"directional_efficiency\":1.0,\"range_atr_multiple\":3.0},"
    testPayload += "\"htf_bias\":\"NEUTRAL\","
    testPayload += "\"displacement\":\"NONE\""
    testPayload += "},"
    testPayload += "\"session\":{\"name\":\"" + sessionName + "\",\"current_high\":" + f_num(currentSessionHigh) + ",\"current_low\":" + f_num(currentSessionLow) + ",\"completed_high\":" + f_num(completedSessionHigh) + ",\"completed_low\":" + f_num(completedSessionLow) + "},"
    testPayload += "\"diagnostics\":{\"policy_version\":\"strict_v1\",\"bar_close_time\":\"" + str.format_time(time_close, "yyyy-MM-dd'T'HH:mm:ss'Z'", "UTC") + "\",\"test_mode\":true,\"atr\":" + f_num(atr) + ",\"mintick\":" + f_num(tick) + ",\"notes\":\"Delivery test only; strict validator must reject\"}"
    testPayload += "}"
    alert(testPayload, alert.freq_once_per_bar_close)
    testWebhookAlertSent := true

// Mark FVG mitigation after candidate checks so the first retest can still alert.
float fvgMid = (fvgLow + fvgHigh) / 2.0
bool bullFvgMitigated = activeBullFvg and bar_index > fvgBar and low <= fvgMid
bool bearFvgMitigated = activeBearFvg and bar_index > fvgBar and high >= fvgMid
if barstate.isconfirmed and (fvgState == "BULLISH" or fvgState == "BEARISH") and (bullFvgMitigated or bearFvgMitigated or fvgExpired or zoneInvalidated)
    fvgState := zoneInvalidated ? "INVALIDATED" : fvgExpired ? "EXPIRED" : "MITIGATED"
    f_retire_box(activeFvgBox, fvgState)
    activeFvgBox := na

// -----------------------------------------------------------------------------+
// The table exposes each hard gate for the currently active FVG, including
// near misses. Counts cover the most recent 100 bars loaded on the chart.
// -----------------------------------------------------------------------------+
var table diag = table.new(position.top_right, 2, panelMode == "Compact" ? 8 : 20, frame_color=color.new(color.white, 55), frame_width=1, border_width=1)

f_table_row(int row, string name, string value) =>
    table.cell(diag, 0, row, name, text_color=color.white, bgcolor=color.rgb(26, 29, 34), text_size=size.small)
    table.cell(diag, 1, row, value, text_color=f_state_color(value), bgcolor=color.rgb(26, 29, 34), text_size=size.small)

if showDiagnostics and barstate.islast
    // Report the post-retest lifecycle, while retaining the confirmed candidate
    // result from before mitigation. Event age/eligibility is never just a color.
    string fvgDisplay = zoneInvalidated and not barstate.isconfirmed ? "INVALID PREVIEW" : fvgExpired ? "EXPIRED" : fvgState
    string consolidationDisplay = consolidationActive ? "BLOCKING" : "INACTIVE"
    bool hasDirectionalFvg = (activeBullFvg and fvgState == "BULLISH") or (activeBearFvg and fvgState == "BEARISH")
    bool liquidityGate = activeBullFvg ? bullSweepRecent or bullSmtRecent : activeBearFvg ? bearSweepRecent or bearSmtRecent : false
    bool structureGate = activeBullFvg ? bullBosRecent and htfBias == "BULLISH" : activeBearFvg ? bearBosRecent and htfBias == "BEARISH" : false
    float directionalRR = activeBullFvg ? bullRR : activeBearFvg ? bearRR : na
    int directionalScore = selectedCandidate ? selectedScore : hasDirectionalFvg ? (activeBullFvg ? bullScore : bearScore) : 0
    bool riskGate = activeBullFvg ? close > bullStop and close < bullTarget and bullRR >= math.max(1.5, minRR) : activeBearFvg ? close < bearStop and close > bearTarget and bearRR >= math.max(1.5, minRR) : false
    string blocker = not supportedChart ? "Unsupported chart" : not sessionDataReady ? "1m data incomplete" : not companionAligned ? "Companion data" : consolidationActive ? "Consolidation" : not hasDirectionalFvg ? "No active FVG" : not fvgTouched ? "Await retest" : not sequenceValid ? "Sequence/age" : not structureGate ? "BOS + HTF" : not liquidityGate ? "Liquidity" : not volumeAllowed ? "Thin volume" : directionalScore < minRuleScore ? "Score" : not riskGate ? "Risk geometry" : alreadyAlertedThisFvg ? "Already emitted" : "Await close"
    string candleStatus = barstate.isconfirmed ? "CLOSED" : "OPEN / PREVIEW"
    string sessionStatus = not sessionDataReady ? "MISSING / PARTIAL" : barstate.isconfirmed ? "COMPLETE" : "PREVIEW"
    if panelMode == "Compact"
        f_table_row(0, "SMC strict_v1", candidateDirection == "NONE" ? "WAIT" : candidateDirection)
        f_table_row(1, "Gate", selectedCandidate ? "PASS" : blocker)
        f_table_row(2, "Candle", candleStatus)
        f_table_row(3, "Score", hasDirectionalFvg or selectedCandidate ? str.tostring(directionalScore) + "/100 (min " + str.tostring(minRuleScore) + ")" : "No setup")
        f_table_row(4, "HTF " + effectiveHtfTimeframe, htfBias)
        f_table_row(5, "Session (1m)", na(sessionAsOf) ? "NO DATA" : sessionName)
        f_table_row(6, "Setups / 100 bars", str.tostring(recentCandidates))
        f_table_row(7, "News / final decision", "Backend only")
    else
        f_table_row(0, "Candle", candleStatus)
        f_table_row(1, "Gate", selectedCandidate ? "PASS" : blocker)
        f_table_row(2, "Last BOS", f_event_status(bosState, bosAge, bullBosRecent or bearBosRecent))
        f_table_row(3, "FVG now", fvgDisplay)
        f_table_row(4, "Last sweep", f_event_status(sweepState, sweepAge, bullSweepRecent or bearSweepRecent))
        f_table_row(5, "Last SMT", f_event_status(smtState, smtAge, bullSmtRecent or bearSmtRecent))
        f_table_row(6, "RVOL", volumeState + " " + str.tostring(rvol, "0.00"))
        f_table_row(7, "Consolidation", consolidationDisplay)
        f_table_row(8, "HTF " + effectiveHtfTimeframe, htfBias)
        f_table_row(9, "Session (1m)", na(sessionAsOf) ? "NO DATA" : sessionName)
        f_table_row(10, "1m coverage", sessionStatus)
        f_table_row(11, "Pool low / high", f_num(sweepSessionLow) + " / " + f_num(sweepSessionHigh))
        f_table_row(12, "Prior day low / high", f_num(priorDayLow) + " / " + f_num(priorDayHigh))
        f_table_row(13, "FVG retest", (hasDirectionalFvg or selectedCandidate) and fvgTouched ? "PASS" : "BLOCK")
        f_table_row(14, "BOS + HTF", hasDirectionalFvg and structureGate ? "PASS" : "BLOCK")
        f_table_row(15, "Liquidity / sequence", (liquidityGate ? "PASS" : "BLOCK") + " / " + (sequenceValid ? "PASS" : "BLOCK"))
        f_table_row(16, "Companion / RR", (companionAligned ? "PASS" : "BLOCK") + " / " + (riskGate ? "PASS" : "BLOCK"))
        f_table_row(17, "Score / minimum", str.tostring(directionalScore) + "/100 | " + str.tostring(minRuleScore))
        f_table_row(18, "Retests / setups 100", str.tostring(recentFvgRetests) + "/" + str.tostring(recentCandidates))
        f_table_row(19, "Candidate", candidateDirection)
