APP_ENV=development
APP_HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./smc_llm.db
WEBHOOK_SECRET=replace-with-a-long-random-value
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
LLM_CONFIDENCE_APPROVE_THRESHOLD=70
LLM_CONFIDENCE_WATCHLIST_THRESHOLD=55
MAX_SETUP_AGE_MINUTES=15
MIN_RULE_SCORE=75
CONFIRMATION_MAX_BARS=6
# mock (local), manual, showmytrades (free automatic USD calendar), or forexfactory
NEWS_PROVIDER=mock
REQUIRE_VERIFIED_NEWS=true
NEWS_MAX_AGE_HOURS=24
NEWS_REFRESH_INTERVAL_MINUTES=60
NEWS_FETCH_TIMEOUT_SECONDS=10
ALERT_OBSERVATION_MAX_HOURS=24
DEFAULT_BLACKOUT_MINUTES_BEFORE=30
DEFAULT_BLACKOUT_MINUTES_AFTER=30
NOTIFICATION_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_NOTIFICATIONS=false
NOTIFICATION_TIMEOUT_SECONDS=5
TIMEZONE=America/New_York
